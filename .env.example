# YouTube Data API v3 Key (Get from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Hugging Face Model for Sentence Transformers
# Default: all-MiniLM-L6-v2 (compact, fast, high semantic accuracy)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Whisper model size (tiny, base, small, medium)
WHISPER_MODEL_SIZE=tiny

# FastAPI Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Streamlit Frontend Settings
STREAMLIT_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# Cache and Storage Settings
CACHE_DIR=data/cache
ENABLE_SQLITE_CACHE=true
SQLITE_DB_PATH=data/video_retrieval.db
